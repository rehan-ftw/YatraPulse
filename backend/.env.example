# YatraPulse backend configuration
# Copy this file to `.env` and adjust as needed. NEVER commit the real .env.

# --- Database (MySQL) ---
# The project ships with a script that runs an isolated local MySQL instance
# on port 3307 (see scripts/db.sh). These defaults match that instance.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=yatra
DB_PASSWORD=yatra_dev_pw
DB_NAME=yatrapulse

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000

# Comma-separated list of allowed CORS origins (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Dynamic ETA engine coefficients (configurable, see services/eta.py) ---
# Weight applied to the historical average delay component.
ETA_HISTORICAL_WEIGHT=0.5
# Minutes of dwell added per congestion event at a station.
ETA_CONGESTION_DWELL=8
# Propagation factors for downstream trains (source impact * factor).
ETA_DOWNSTREAM_FACTORS=0.6,0.4,0.25
